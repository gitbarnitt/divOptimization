# Helper: safe integer seed
seed_i32 <- function(x) {
m <- .Machine$integer.max
as.integer(((x %% m) + m) %% m)
}
# Helper: deterministic int32-ish seed from string
site_seed <- function(x) {
vals <- utf8ToInt(x)
if (length(vals) == 0) return(1L)
m <- .Machine$integer.max
acc <- 0L
for (i in seq_along(vals)) {
acc <- as.integer((acc + (vals[i] * i) %% m) %% m)
}
acc + 1L
}
