n_rows_for_k <- function(k) {
sampled_plots <- sample(plots, min(k, length(plots)), replace = FALSE)
idx <- unlist(lapply(sampled_plots, function(p) row_ids_by_plot_year[[paste(yr, p, sep=".")]]))
length(idx)
}
