gamma_draws <- tibble(
draw = 1:G,
gamma = rnorm(G, mean = 0.065, sd = 0.045)
)
delta_draws <- tibble(
draw = 1:G,
Delta = rnorm(G, mean = 0.28, sd = 0.16)
)
tau_s <- 0.20
p_delta <- ggplot(delta_draws, aes(x = Delta)) +
geom_rug(alpha = 0.12, linewidth = 0.3) +
geom_area(
data = delta_draws %>% filter(abs(Delta) >= tau_s),
stat = "density",
alpha = 0.35
) +
geom_density(linewidth = 1.2) +
geom_vline(xintercept = c(-tau_s, tau_s), linetype = "dashed") +
geom_text(
data = data.frame(
x = tau_s + 0.08,
y = max(density(delta_draws$Delta)$y) * 0.9
),
aes(
x = x,
y = y,
label = "P(abs(Delta[s]) >= tau[s])"
),
parse = TRUE,
inherit.aes = FALSE,
hjust = 0,
size = 5
) +
labs(
title = "Posterior distribution of imposed change",
subtitle = expression(Delta[s]^{(g)} == bar(mu)[s*K]^{pert*(g)} - bar(mu)[s*K]^{(g)}),
x = expression(Delta[s]^{(g)}),
y = "Posterior density"
) +
theme_classic(base_size = 15) +
theme(
axis.text.y = element_blank(),
axis.ticks.y = element_blank()
)
p_delta
gamma_draws <- tibble(
draw = 1:G,
gamma = rnorm(G, mean = 0.065, sd = 0.045)
)
T_span <- 5
delta <- 0.20
slope_threshold <- delta / T_span
p_gamma <- ggplot(gamma_draws, aes(x = gamma)) +
geom_rug(alpha = 0.12, linewidth = 0.3) +
geom_area(
data = gamma_draws %>% filter(abs(gamma) >= slope_threshold),
stat = "density",
alpha = 0.35
) +
geom_density(linewidth = 1.2) +
geom_vline(xintercept = c(-slope_threshold, slope_threshold), linetype = "dashed") +
geom_text(
data = data.frame(
x = slope_threshold + 0.015,
y = max(density(gamma_draws$gamma)$y) * 0.9
),
aes(
x = x,
y = y,
label = "P(abs(gamma[s*K]) >= delta/T)"
),
parse = TRUE,
inherit.aes = FALSE,
hjust = 0,
size = 5
) +
labs(
title = "Posterior distribution of trend slope",
subtitle = expression(gamma[s*K]^{(g)}),
x = expression(gamma[s*K]^{(g)}),
y = "Posterior density"
) +
theme_classic(base_size = 15) +
theme(
axis.text.y = element_blank(),
axis.ticks.y = element_blank()
)
p_gamma
