y = "Fraction of species detectable"
) +
theme_bw()
# Panel A
p_detect <- sensA_trend_community %>%
filter(siteID == "HARV", window_years == 5, window_start == target_window) %>%
ggplot(aes(x = sample_size, y = frac_detectable)) +
geom_line() +
geom_point() +
geom_hline(yintercept = 0.80, linetype = "dashed") +
scale_x_reverse(breaks = sort(unique(sensA_trend_community$sample_size), decreasing = TRUE)) +
labs(
title = "A. Threshold-based trend detection",
x = "Number of plots sampled per year (K)",
y = "Fraction of species detectable"
) +
theme_bw()
# Panel B
p_cv <- stability_community %>%
filter(siteID == "HARV", window_years == 5, window_start == target_window) %>%
ggplot(aes(x = sample_size, y = median_slope_cv)) +
geom_line() +
geom_point() +
geom_hline(yintercept = 0.50, linetype = "dashed") +
scale_x_reverse(breaks = sort(unique(stability_community$sample_size), decreasing = TRUE)) +
labs(
title = "B. Slope estimation stability",
x = "Number of plots sampled per year (K)",
y = "Median slope CV"
) +
theme_bw()
p_detect / p_cv
