library(DiagrammeR)
grViz("
digraph workflow {
graph [layout = dot, rankdir = TB]
node [shape = box, style = rounded, fontname = Helvetica]
data [label = 'Observed data\n(plot × year × species)']
model [label = 'Fit GJAM model']
posterior [label = 'Posterior draws\nμ^(g), Σ^(g)']
data -> model -> posterior
node [shape = box]
subgraph cluster_change {
label = 'Counterfactual change detection'
style = dashed
pert [label = 'Apply perturbation\nμ^pert = μ + δ c̄']
subsample1 [label = 'Subsample K plots']
aggregate1 [label = 'Aggregate\nμ̄_s,K^(g)']
detect1 [label = 'Detection probability\nP(|Δ| ≥ τ)']
summary1 [label = 'Fraction detectable / N*']
pert -> subsample1 -> aggregate1 -> detect1 -> summary1
}
subgraph cluster_trend {
label = 'Trend analysis'
style = dashed
subsample2 [label = 'Subsample K plots per year']
aggregate2 [label = 'Annual means\nμ̄_s,t,K^(g)']
slope [label = 'Fit slope γ']
detect2 [label = 'Detection\nP(|γ| ≥ δ/T)']
stability [label = 'Stability\nCV_s(K)']
summary2 [label = 'N*, K_CV50']
subsample2 -> aggregate2 -> slope -> detect2
slope -> stability
detect2 -> summary2
stability -> summary2
}
posterior -> pert
posterior -> subsample2
}
")
grViz("
digraph counterfactual {
graph [layout = dot, rankdir = TB]
node [shape = box, style = rounded, fontname = Helvetica]
mu [label = 'Posterior draws\nμ_s,p^(g)']
pert [label = 'Perturbation\nμ^pert = μ + δ c̄_s']
subsample [label = 'Subsample K plots']
mean [label = 'Aggregate\nμ̄_s,K^(g)']
diff [label = 'Difference\nΔ_s^(g)']
prob [label = 'P(|Δ| ≥ τ_s)']
decision [label = 'Detection\nP ≥ 0.80']
summary [label = 'Fraction detectable']
mu -> pert -> subsample -> mean -> diff -> prob -> decision -> summary
}
")
grViz("
digraph trend {
graph [layout = dot, rankdir = TB]
node [shape = box, style = rounded, fontname = Helvetica]
mu [label = 'Posterior draws\nμ_s,p,t^(g)']
subsample [label = 'Subsample K plots per year']
mean [label = 'Annual means\nμ̄_s,t,K^(g)']
slope [label = 'Slope\nγ_s,K^(g)']
detect [label = 'Detection\nP(|γ| ≥ δ/T)']
cv [label = 'Stability\nCV_s(K)']
summary [label = 'N*, K_CV50']
mu -> subsample -> mean -> slope
slope -> detect
slope -> cv
detect -> summary
cv -> summary
}
")
library(ggplot2)
library(dplyr)
set.seed(1)
G <- 1000
delta_draws <- tibble(
draw = 1:G,
Delta = rnorm(G, mean = 0.28, sd = 0.16)
)
tau_s <- 0.20
p_delta <- ggplot(delta_draws, aes(x = Delta)) +
# faint draw-level marks to show posterior iterations
geom_jitter(
height = 0.015,
alpha = 0.12,
) +
# shaded detection region
geom_area(
stat = "density",
alpha = 0.35
# full density curve
geom_vline(xintercept = c(-tau_s, tau_s), linetype = "dashed") +
"text",
y = 1.7,
gamma_draws <- tibble(
draw = 1:G,
gamma = rnorm(G, mean = 0.065, sd = 0.045)
)
slope_threshold <- 0.20 / 5  # example: 20% over 5-year span
p_gamma <- ggplot(gamma_draws, aes(x = gamma)) +
# faint draw-level marks to show posterior iterations
geom_jitter(
height = 0.015,
alpha = 0.12,
) +
# shaded detection region
geom_area(
stat = "density",
alpha = 0.35
# full density curve
geom_vline(xintercept = c(-slope_threshold, slope_threshold), linetype = "dashed") +
library(ggplot2)
library(dplyr)
set.seed(1)
G <- 1000
delta_draws <- tibble(
draw = 1:G,
Delta = rnorm(G, mean = 0.28, sd = 0.16)
)
tau_s <- 0.20
p_delta <- ggplot(delta_draws, aes(x = Delta)) +
geom_jitter(
aes(y = 0),
height = 0.015,
width = 0,
alpha = 0.12,
size = 0.8
) +
geom_area(
data = delta_draws %>% filter(abs(Delta) >= tau_s),
stat = "density",
alpha = 0.35
) +
geom_density(linewidth = 1.2) +
geom_vline(xintercept = c(-tau_s, tau_s), linetype = "dashed") +
annotate(
"text",
x = tau_s + 0.1,
y = 1.5,
label = "P(|Δ| ≥ τ)",
hjust = 0,
size = 5
) +
labs(
title = "Posterior distribution of imposed change",
subtitle = "Δ_s^(g) = μ̄_s,K^(pert,g) − μ̄_s,K^(g)",
x = "Δ_s^(g)",
y = "Density"
) +
theme_classic(base_size = 15) +
theme(
axis.text.y = element_blank(),
axis.ticks.y = element_blank()
)
p_delta
library(ggplot2)
library(dplyr)
set.seed(1)
G <- 1000
# ===============================
# 1. Counterfactual change figure
# ===============================
delta_draws <- tibble(
draw = 1:G,
Delta = rnorm(G, mean = 0.28, sd = 0.16)
)
tau_s <- 0.20
p_delta <- ggplot(delta_draws, aes(x = Delta)) +
geom_rug(alpha = 0.12, linewidth = 0.3) +
geom_area(
data = delta_draws %>% filter(abs(Delta) >= tau_s),
stat = "density",
alpha = 0.35
) +
geom_density(linewidth = 1.2) +
geom_vline(xintercept = c(-tau_s, tau_s), linetype = "dashed") +
annotate(
"text",
x = tau_s + 0.08,
y = 1.55,
label = "P(|Δ[s]| >= τ[s])",
parse = TRUE,
hjust = 0,
size = 5
) +
labs(
title = "Posterior distribution of imposed change",
subtitle = expression(Delta[s]^{(g)} == bar(mu)[s*K]^{pert*(g)} - bar(mu)[s*K]^{(g)}),
x = expression(Delta[s]^{(g)}),
y = "Posterior density"
) +
theme_classic(base_size = 15) +
theme(
axis.text.y = element_blank(),
axis.ticks.y = element_blank()
)
p_delta
library(ggplot2)
library(dplyr)
set.seed(1)
G <- 1000
# ===============================
# 1. Counterfactual change figure
# ===============================
delta_draws <- tibble(
draw = 1:G,
Delta = rnorm(G, mean = 0.28, sd = 0.16)
)
tau_s <- 0.20
p_delta <- ggplot(delta_draws, aes(x = Delta)) +
geom_rug(alpha = 0.12, linewidth = 0.3) +
geom_area(
data = delta_draws %>% filter(abs(Delta) >= tau_s),
stat = "density",
alpha = 0.35
) +
geom_density(linewidth = 1.2) +
geom_vline(xintercept = c(-tau_s, tau_s), linetype = "dashed") +
annotate(
"text",
x = tau_s + 0.08,
y = 1.55,
label = expression(P(abs(Delta[s]) >= tau[s])),
hjust = 0,
size = 5
) +
labs(
title = "Posterior distribution of imposed change",
subtitle = expression(Delta[s]^{(g)} == bar(mu)[s*K]^{pert*(g)} - bar(mu)[s*K]^{(g)}),
x = expression(Delta[s]^{(g)}),
y = "Posterior density"
) +
theme_classic(base_size = 15) +
theme(
axis.text.y = element_blank(),
axis.ticks.y = element_blank()
)
