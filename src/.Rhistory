# Plots per NLCD class
div_1m2Data %>%
filter(siteID == "OSBS") %>%
distinct(plotID, nlcdClass) %>%
count(nlcdClass, name = "n_plots")
# Plots per NLCD class per year
div_1m2Data %>%
filter(siteID == "OSBS") %>%
distinct(plotID, year, nlcdClass) %>%
count(nlcdClass, year) %>%
tidyr::spread(year, n, fill = 0)
# Power curve at K=5 and K=max by effect size
p05 <- read_parquet("C:/Users/dbarnett/OneDrive - Battelle Ecology/optimization/outputs/tierp0/outputs_ygibbs/BARR/tierp0/new41/div_optimization_outputs_ygibbs_BARR_tierp0_power_curve_effect0.05.parquet") %>% mutate(effect = 0.05)
p10 <- read_parquet("C:/Users/dbarnett/OneDrive - Battelle Ecology/optimization/outputs/tierp0/outputs_ygibbs/BARR/tierp0/new41/div_optimization_outputs_ygibbs_BARR_tierp0_power_curve_effect0.10.parquet") %>% mutate(effect = 0.10)
p20 <- read_parquet("C:/Users/dbarnett/OneDrive - Battelle Ecology/optimization/outputs/tierp0/outputs_ygibbs/BARR/tierp0/new41/div_optimization_outputs_ygibbs_BARR_tierp0_power_curve_effect0.20.parquet") %>% mutate(effect = 0.20)
# Get species mean cover from raw data
sp_cover <- div_1m2Data %>%
filter(siteID == "BARR") %>%
group_by(taxonID) %>%
summarise(mean_cover = mean(percentCover, na.rm = TRUE)) %>%
rename(species = taxonID)
p20 %>%
filter(sample_size == 30) %>%
group_by(species) %>%
summarise(mean_power = mean(power)) %>%
left_join(sp_cover, by = "species") %>%
arrange(mean_cover) %>%
print(n = 57)
div_1m2Data %>%
group_by(siteID, taxonID) %>%
summarise(mean_cover = mean(percentCover, na.rm = TRUE), .groups = "drop") %>%
group_by(siteID) %>%
summarise(
total_species = n(),
above_5pct = sum(mean_cover >= 5),
above_2pct = sum(mean_cover >= 2),
above_1pct = sum(mean_cover >= 1),
.groups = "drop"
) %>%
print(n = 50)
div_1m2Data %>%
group_by(siteID, taxonID) %>%
summarise(mean_cover = mean(percentCover, na.rm = TRUE), .groups = "drop") %>%
group_by(siteID) %>%
summarise(
total_species = n(),
above_5pct = sum(mean_cover >= 5, na.rm = TRUE),
above_2pct = sum(mean_cover >= 2, na.rm = TRUE),
above_1pct = sum(mean_cover >= 1, na.rm = TRUE),
.groups = "drop"
