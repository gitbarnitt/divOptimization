mutate(sampled = 1) %>%
complete(plotID, year = min(year):max(year), fill = list(sampled = 0)) %>%
pivot_wider(names_from = year, values_from = sampled, values_fill = 0)
cat("\nPlot x Year matrix (1 = sampled):\n")
print(as.data.frame(xtab), row.names = FALSE)
# Check each window width
for (W in window_widths) {
cat(sprintf("\n--- Window width: %d years ---\n", W))
if (length(all_years) < W) {
cat("  Not enough years for this window width\n")
next
}
# Generate all possible windows
start_years <- all_years[1]:(max(all_years) - W + 1)
for (sy in start_years) {
window_years <- sy:(sy + W - 1)
# Count plots sampled in ALL years of this window
plots_in_window <- site_dat %>%
filter(year %in% window_years) %>%
group_by(plotID) %>%
summarise(n_years = n_distinct(year), .groups = "drop") %>%
filter(n_years == W)
cat(sprintf("  %d-%d: %d plots with complete records\n",
sy, sy + W - 1, nrow(plots_in_window)))
}
}
}
# Check JERC first
check_plot_continuity(div_1m2Data, "JERC")
##
# Quick summary across all sites
all_sites <- sort(unique(div_1m2Data$siteID))
continuity_summary <- lapply(all_sites, function(s) {
site_dat <- div_1m2Data %>%
filter(siteID == s) %>%
distinct(plotID, year) %>%
mutate(year = as.integer(year))
all_years <- sort(unique(site_dat$year))
n_plots <- length(unique(site_dat$plotID))
# 5-year windows
w5_results <- if (length(all_years) >= 5) {
starts <- all_years[1]:(max(all_years) - 4)
sapply(starts, function(sy) {
site_dat %>%
filter(year %in% (sy:(sy+4))) %>%
group_by(plotID) %>%
summarise(n = n_distinct(year), .groups = "drop") %>%
filter(n == 5) %>% nrow()
})
} else numeric(0)
data.frame(
site = s,
n_plots = n_plots,
n_years = length(all_years),
w5_min = if (length(w5_results) > 0) min(w5_results) else NA,
w5_max = if (length(w5_results) > 0) max(w5_results) else NA,
w5_median = if (length(w5_results) > 0) median(w5_results) else NA
)
}) %>% bind_rows()
print(continuity_summary, n = 50)
View(continuity_summary)
print(continuity_summary)
check_plot_continuity(div_1m2Data, "BARR")
View(continuity_summary)
