jercTrend_baselineTrend <- read_parquet("C:/Users/dbarnett/OneDrive - Battelle Ecology/optimization/outputs/trendRun/JERC/div_optimization_outputs_trendrun_JERC_trendrun_baseline_trend_species.parquet")
print(jercTrend_baselineTrend)
# Join baseline slopes with SensA detect_prob
mde_data <- jercTrend_SensA_species %>%
inner_join(
jercTrend_baselineTrend %>% select(species, slope_median),
by = "species"
) %>%
mutate(abs_slope = abs(slope_median))
# For each window and sample size, summarize detect_prob vs abs_slope
# Bin species by slope magnitude and compute mean detect_prob per bin
mde_data %>%
filter(window_start == 2015, sample_size == max(sample_size)) %>%
mutate(slope_bin = cut(abs_slope, breaks = seq(0, max(abs_slope) + 0.02, by = 0.02))) %>%
group_by(slope_bin) %>%
summarise(
n_species = n(),
mean_detect = mean(detect_prob),
.groups = "drop"
) %>%
print(n = 30)
# Quick scatterplot: detect_prob vs |slope| at each K
library(ggplot2)
mde_data %>%
filter(window_start == 2015) %>%
ggplot(aes(x = abs_slope, y = detect_prob)) +
geom_point(alpha = 0.3) +
geom_smooth(method = "loess") +
geom_hline(yintercept = 0.80, linetype = "dashed", color = "red") +
facet_wrap(~sample_size) +
labs(x = "|Baseline slope| (cover units/yr)",
y = "Detection probability",
title = "JERC: Minimum Detectable Effect by Sample Size") +
theme_minimal()
mde_data %>%
filter(window_start == 2015) %>%
ggplot(aes(x = abs_slope, y = detect_prob)) +
geom_point(alpha = 0.3) +
geom_smooth(method = "glm", method.args = list(family = quasibinomial),
formula = y ~ x, se = TRUE) +
geom_hline(yintercept = 0.80, linetype = "dashed", color = "red") +
facet_wrap(~sample_size) +
labs(x = "|Baseline slope| (cover units/yr)",
y = "Detection probability",
title = "JERC: Minimum Detectable Effect by Sample Size") +
theme_minimal()
# Compute mean cover per species from the raw data
species_mean_cover <- div_1m2Data %>%
filter(siteID == "JERC") %>%
group_by(plotID, year, taxonID) %>%
summarise(plot_cover = mean(percentCover, na.rm = TRUE), .groups = "drop") %>%
group_by(taxonID) %>%
summarise(mean_cover = mean(plot_cover, na.rm = TRUE), .groups = "drop") %>%
rename(species = taxonID)
# Join and compute relative slope
mde_data_rel <- mde_data %>%
inner_join(species_mean_cover, by = "species") %>%
mutate(
rel_slope = abs(slope_median) / pmax(mean_cover, 0.01),  # relative change/yr
rel_slope_pct = rel_slope * 100                           # as percent/yr
)
# Combined plot: logistic fit + relative x-axis
mde_data_rel %>%
filter(window_start == 2015) %>%
ggplot(aes(x = rel_slope_pct, y = detect_prob)) +
geom_point(alpha = 0.3) +
geom_smooth(method = "glm", method.args = list(family = quasibinomial),
formula = y ~ x, se = TRUE) +
geom_hline(yintercept = 0.80, linetype = "dashed", color = "red") +
facet_wrap(~sample_size) +
coord_cartesian(xlim = c(0, 100)) +  # cap at 100%/yr for readability
labs(x = "Minimum detectable trend (% of mean cover per year)",
y = "Detection probability",
title = "JERC: Minimum Detectable Effect by Sample Size (2015-2019)") +
theme_minimal()
# --- Extract MDE crossing points programmatically ---
mde_crossings <- mde_data_rel %>%
filter(window_start == 2015) %>%
group_by(sample_size) %>%
do({
fit <- glm(detect_prob ~ rel_slope_pct, data = ., family = quasibinomial)
# Find where fitted curve crosses 0.80
# Solve: logit(0.80) = b0 + b1*x  =>  x = (logit(0.80) - b0) / b1
b0 <- coef(fit)[1]
b1 <- coef(fit)[2]
logit_80 <- log(0.80 / 0.20)
mde_pct <- (logit_80 - b0) / b1
data.frame(
mde_pct_per_yr = max(mde_pct, 0),  # floor at 0
b0 = b0,
b1 = b1
)
}) %>%
ungroup()
print(mde_crossings)
